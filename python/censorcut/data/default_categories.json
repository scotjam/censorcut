{
  "schemaVersion": 1,
  "comment": "Built-in categories. Tuning notes: YAMNet scores aren't well-calibrated, so audio.yamnet weights are capped at 0.5 — they confirm a category rather than triggering it on their own. Vision.clip is better calibrated for content semantics and carries the higher weight where applicable. Thresholds are deliberately conservative; the analyzer should err on missing some scenes rather than flagging the entire movie. Tighten further by raising thresholds; loosen by lowering them or bumping audio weights.",
  "categories": [
    {
      "name": "Jump scare",
      "enabled": true,
      "threshold": 0.75,
      "padBeforeMs": 1000,
      "padAfterMs": 1500,
      "maxDurationMs": 6000,
      "detectors": [
        { "id": "audio.lufs.jump", "weight": 0.4 },
        { "id": "audio.yamnet", "weight": 0.3,
          "params": { "labels": ["Screaming", "Gasp",
                                  "Smash, crash", "Bang", "Boom"] } },
        { "id": "vision.clip", "weight": 0.5,
          "params": { "prompts": ["a person screaming in fear",
                                   "a sudden frightening face close-up",
                                   "a monster jumping out at the camera"] } }
      ]
    },
    {
      "name": "Screaming",
      "enabled": true,
      "threshold": 0.7,
      "padBeforeMs": 500,
      "padAfterMs": 800,
      "detectors": [
        { "id": "audio.yamnet", "weight": 0.5,
          "params": { "labels": ["Screaming"] } },
        { "id": "vision.clip", "weight": 0.6,
          "params": { "prompts": ["a person screaming in terror",
                                   "a child crying and screaming"] } }
      ]
    },
    {
      "name": "Crying / sad",
      "enabled": true,
      "threshold": 0.75,
      "padBeforeMs": 500,
      "padAfterMs": 800,
      "detectors": [
        { "id": "audio.yamnet", "weight": 0.5,
          "params": { "labels": ["Crying, sobbing", "Baby cry, infant cry",
                                  "Wail, moan"] } },
        { "id": "vision.clip", "weight": 0.5,
          "params": { "prompts": ["a person crying with tears on their face",
                                   "a child sobbing"] } }
      ]
    },
    {
      "name": "Yelling",
      "enabled": true,
      "threshold": 0.7,
      "padBeforeMs": 400,
      "padAfterMs": 600,
      "detectors": [
        { "id": "audio.yamnet", "weight": 0.4,
          "params": { "labels": ["Yell", "Shout", "Battle cry"] } },
        { "id": "vision.clip", "weight": 0.5,
          "params": { "prompts": ["an angry person yelling at someone",
                                   "an aggressive face shouting"] } }
      ]
    },
    {
      "name": "Gunfire",
      "enabled": true,
      "threshold": 0.6,
      "padBeforeMs": 600,
      "padAfterMs": 800,
      "detectors": [
        { "id": "audio.yamnet", "weight": 0.5,
          "params": { "labels": ["Gunshot, gunfire", "Machine gun",
                                  "Artillery fire", "Fusillade", "Cannon"] } },
        { "id": "vision.clip", "weight": 0.6,
          "params": { "prompts": ["a person aiming a gun at someone",
                                   "a person firing a handgun",
                                   "a soldier shooting a rifle"] } }
      ]
    },
    {
      "name": "Hitting / impacts",
      "enabled": true,
      "threshold": 0.7,
      "padBeforeMs": 400,
      "padAfterMs": 600,
      "detectors": [
        { "id": "audio.yamnet", "weight": 0.4,
          "params": { "labels": ["Slap, smack", "Smash, crash",
                                  "Glass", "Breaking"] } },
        { "id": "vision.clip", "weight": 0.6,
          "params": { "prompts": ["a person punching another person in the face",
                                   "a person being hit hard"] } }
      ]
    },
    {
      "name": "Sword fight",
      "enabled": true,
      "threshold": 0.7,
      "padBeforeMs": 600,
      "padAfterMs": 800,
      "detectors": [
        { "id": "audio.yamnet", "weight": 0.3,
          "params": { "labels": ["Whoosh, swoosh, swish", "Clang"] } },
        { "id": "vision.clip", "weight": 0.7,
          "params": { "prompts": ["two people sword fighting with blades",
                                   "people dueling with swords",
                                   "a knight swinging a sword in battle"] } }
      ]
    },
    {
      "name": "Chase",
      "enabled": true,
      "threshold": 0.7,
      "padBeforeMs": 800,
      "padAfterMs": 800,
      "detectors": [
        { "id": "audio.yamnet", "weight": 0.3,
          "params": { "labels": ["Heavy breathing",
                                  "Race car, auto racing"] } },
        { "id": "vision.clip", "weight": 0.7,
          "params": { "prompts": ["a person running away in panic with someone chasing",
                                   "a high-speed car chase",
                                   "someone being pursued through a chase scene"] } }
      ]
    },
    {
      "name": "Violence (general)",
      "enabled": true,
      "threshold": 0.7,
      "padBeforeMs": 600,
      "padAfterMs": 800,
      "detectors": [
        { "id": "audio.yamnet", "weight": 0.3,
          "params": { "labels": ["Slap, smack", "Smash, crash"] } },
        { "id": "vision.clip", "weight": 0.8,
          "params": { "prompts": ["a violent fight between two people",
                                   "blood on a person's face from injury",
                                   "a brutal beating with someone bleeding"] } }
      ]
    },
    {
      "name": "Cruelty",
      "enabled": true,
      "threshold": 0.8,
      "padBeforeMs": 1000,
      "padAfterMs": 1000,
      "maxDurationMs": 20000,
      "detectors": [
        { "id": "vision.clip", "weight": 1.0,
          "params": { "prompts": ["an adult physically attacking a child",
                                   "a person striking an animal in anger",
                                   "a victim being beaten or tortured"] } }
      ]
    },
    {
      "name": "Pushing",
      "enabled": true,
      "threshold": 0.8,
      "padBeforeMs": 400,
      "padAfterMs": 600,
      "maxDurationMs": 8000,
      "detectors": [
        { "id": "vision.clip", "weight": 1.0,
          "params": { "prompts": ["one person violently shoving another to the ground",
                                   "a person knocked down by a hard shove"] } }
      ]
    },
    {
      "name": "Kill / threat",
      "enabled": true,
      "threshold": 0.65,
      "padBeforeMs": 800,
      "padAfterMs": 1000,
      "detectors": [
        { "id": "vision.clip", "weight": 0.6,
          "params": { "prompts": ["a knife held to someone's throat",
                                   "a gun pointed at a person's head at close range",
                                   "a menacing villain threatening a victim with a weapon"] } },
        { "id": "dialogue.whisper", "weight": 0.8,
          "params": { "labels": ["i'll kill you", "kill you", "going to die",
                                  "going to kill", "you're dead", "murder",
                                  "hunt you down", "shoot you", "stab you",
                                  "no mercy"] } }
      ]
    }
  ]
}
