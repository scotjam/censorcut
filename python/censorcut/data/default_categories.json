{
  "schemaVersion": 1,
  "comment": "Vision-only defaults. Audio detectors (audio.yamnet, audio.lufs.jump) were disabled because YAMNet labels misfire on incidental sounds (car doors, footsteps, music cues) and the M3 LUFS jump-scare heuristic flags any loud-after-quiet pattern, not specifically scary content. Re-enable by adding 'audio.yamnet' / 'audio.lufs.jump' detector entries back into a category. Whisper dialogue stays on for Kill/threat. The Sensitivity slider in the Analyzer panel scales every threshold by 0.5x..2.0x — tune that rather than editing this file.",
  "categories": [
    {
      "name": "Jump scare",
      "enabled": true,
      "threshold": 0.6,
      "padBeforeMs": 1000,
      "padAfterMs": 1500,
      "maxDurationMs": 6000,
      "detectors": [
        { "id": "vision.clip", "weight": 1.0,
          "params": { "prompts": ["a person screaming in fear",
                                   "a sudden frightening face close-up",
                                   "a monster jumping out at the camera",
                                   "a startled wide-eyed terrified expression"] } }
      ]
    },
